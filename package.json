{
  "name": "chat-demo",
  "version": "0.1.1",
  "description": "基于 DeepSeek API 的静态聊天示例。",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "rspack serve -c rspack.config.ts",
    "build": "rm -rf dist && NODE_ENV=production rspack build -c rspack.config.ts",
    "type": "tsc -p tsconfig.json",
    "lint": "oxlint src rspack.config.ts",
    "format": "oxfmt --write .",
    "dev:api": "tsx watch server/src/index.ts",
    "type:server": "tsc -p server/tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test:server": "node --import tsx --test server/tests/*.test.ts",
    "test:frontend": "node --import tsx --test tests/frontend/*.test.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.22",
    "@hono/node-server": "^2.1.8",
    "@types/katex": "^0.16.5",
    "@types/mdast": "~4.0.3",
    "@types/prismjs": "^1.26.1",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "better-auth": "^1.7.22",
    "clsx": "2.1.1",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "fflate": "0.8.3",
    "hono": "^4.13.18",
    "idb": "8.0.3",
    "katex": "0.16.22",
    "mdast-util-find-and-replace": "3.0.2",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-math": "3.0.0",
    "mermaid": "11.10.1",
    "micromark-extension-gfm": "3.0.0",
    "micromark-extension-llm-math": "3.1.0",
    "pg": "^8.23.1",
    "prismjs": "1.30.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "^4.6.7",
    "zustand": "4.4.7"
  },
  "devDependencies": {
    "@rspack/cli": "2.0.2",
    "@rspack/core": "2.0.2",
    "@rspack/dev-server": "2.0.1",
    "@swc/helpers": "0.5.23",
    "@types/node": "~20.9.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "oxfmt": "0.48.0",
    "oxlint": "1.63.0",
    "tsx": "^4.23.15",
    "typescript": "7.0.2"
  }
}
